# Server-side ONLY. Share the TLC Master Sheet with this service account as Viewer.
TLC_MASTER_SHEET_ID=
TLC_GOOGLE_SERVICE_ACCOUNT_EMAIL=
TLC_GOOGLE_PRIVATE_KEY=
# Explicitly approved, exact worksheet + Property ID keys; never enable entire tab.
# Example: ["Commercial Inventory:COM-123"]
TLC_PUBLIC_APPROVED_IDS=[]

# Batch 03: optional STAGING-only PostgreSQL endpoint. Leave unset until reviewed.
# Never expose this in NEXT_PUBLIC_* or point it at an existing live database.
TLC_DATABASE_URL=

# Batch 04+ (not activated by source code alone)
# Supabase Auth must be provisioned and users invited by an authorized administrator.
NEXT_PUBLIC_TLC_SUPABASE_URL=
NEXT_PUBLIC_TLC_SUPABASE_ANON_KEY=
# Use the auth provider's exact issuer, audience and HTTPS JWKS address.
# For Supabase asymmetric signing keys, JWKS: https://<project>.supabase.co/auth/v1/.well-known/jwks.json
TLC_AUTH_ISSUER=
TLC_AUTH_AUDIENCE=authenticated
TLC_AUTH_JWKS_URL=
# Required before public enquiries can be accepted
TLC_TURNSTILE_SECRET=
NEXT_PUBLIC_TLC_TURNSTILE_SITE_KEY=

# Only use the exact allowed production hostname for CAPTCHA verification.
TLC_PUBLIC_HOSTNAME=

# Keep disabled until staging migrations, grants and owner evidence process are reviewed.
TLC_MASTER_APPROVAL_WRITES=disabled

# Server-side ONLY. Share the TLC Master Sheet with this service account as Viewer.
TLC_GOOGLE_SERVICE_ACCOUNT_EMAIL=
TLC_GOOGLE_PRIVATE_KEY=
# Explicitly approved, exact worksheet + Unit ID keys; never enable entire tab.
# Example: ["Commercial Lease Inventory:COM-123"]
TLC_PUBLIC_APPROVED_IDS=[]

# Batch 03: optional STAGING-only PostgreSQL endpoint. Leave unset until reviewed.
# Never expose this in NEXT_PUBLIC_* or point it at an existing live database.
TLC_DATABASE_URL=

# Batch 04 staging authentication (server-side only; intentionally empty).
TLC_AUTH_URL=
TLC_AUTH_ANON_KEY=
